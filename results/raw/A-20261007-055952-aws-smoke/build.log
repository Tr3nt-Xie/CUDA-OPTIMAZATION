cc -Iinclude -Isrc -D_POSIX_C_SOURCE=200809L -O2 -std=c11 -Wall -Wextra -Wpedantic -MMD -MP -c src/matrix/cpu.c -o build/cpu/matrix/cpu.o
cc -Iinclude -Isrc -D_POSIX_C_SOURCE=200809L -O2 -std=c11 -Wall -Wextra -Wpedantic -MMD -MP -c src/convolution/cpu.c -o build/cpu/convolution/cpu.o
cc -Iinclude -Isrc -D_POSIX_C_SOURCE=200809L -O2 -std=c11 -Wall -Wextra -Wpedantic -MMD -MP -c apps/harness.c -o build/apps/harness.o
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 -Xcompiler=-fPIC -c src/matrix/naive.cu -o build/cuda/matrix/naive.o
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 -Xcompiler=-fPIC -c src/matrix/tiled.cu -o build/cuda/matrix/tiled.o
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 -Xcompiler=-fPIC -c src/matrix/optimized.cu -o build/cuda/matrix/optimized.o
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 -Xcompiler=-fPIC -c src/matrix/cublas.cu -o build/cuda/matrix/cublas.o
ar rcs build/liblab6_cpu.a build/cpu/matrix/cpu.o build/cpu/convolution/cpu.o
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 -Xcompiler=-fPIC -c src/convolution/cuda.cu -o build/cuda/convolution/cuda.o
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 -Xcompiler=-fPIC -c src/bindings/exports.cu -o build/cuda/bindings/exports.o
cc -Iinclude -Isrc -D_POSIX_C_SOURCE=200809L -O2 -std=c11 -Wall -Wextra -Wpedantic apps/bench_cpu.c build/apps/harness.o build/liblab6_cpu.a \
	 -lm -o build/bench_cpu
nvcc -O2 -std=c++14 -arch=sm_75 -shared build/cuda/matrix/naive.o build/cuda/matrix/tiled.o build/cuda/matrix/optimized.o build/cuda/matrix/cublas.o build/cuda/convolution/cuda.o build/cuda/bindings/exports.o  -lcublas -o build/liblab6_cuda.so
nvcc -Iinclude -Isrc -O2 -std=c++14 -arch=sm_75 apps/bench_cuda.cu build/apps/harness.o -Lbuild -llab6_cuda \
	-Xlinker -rpath -Xlinker '$ORIGIN'  -lm -o build/bench_cuda
